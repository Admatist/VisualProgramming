<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.sro1vp17varabdkprv.EmployeeDialogController"
      prefWidth="400" prefHeight="300">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Введите данные сотрудника:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="ФИО:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" promptText="Иванов Иван Иванович" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Отдел:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="departmentField" promptText="IT, HR, Finance..." GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Должность:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="positionField" promptText="Developer, Manager..." GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Стаж (лет):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="experienceField" promptText="Число лет" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Сохранить" fx:id="saveButton" onAction="#handleSave" defaultButton="true"/>
        <Button text="Отмена" onAction="#handleCancel" cancelButton="true"/>
    </HBox>
</VBox>