<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.sro1vp17varabdkprv.HelloController"
      prefWidth="700" prefHeight="500">

    <!-- Верхнее меню (MenuBar) -->
    <MenuBar>
        <Menu text="Файл">
            <MenuItem text="Добавить сотрудника" onAction="#handleAddEmployee"/>
            <SeparatorMenuItem/>
            <MenuItem text="Выход" onAction="#handleExit"/>
        </Menu>
        <Menu text="Справка">
            <MenuItem text="О программе" onAction="#handleAbout"/>
        </Menu>
    </MenuBar>

    <!-- Панель инструментов (ToolBar) -->
    <ToolBar>
        <Button text="Добавить" onAction="#handleAddEmployee"/>
        <Button text="Редактировать" onAction="#handleEditEmployee"/>
        <Button text="Удалить" onAction="#handleDeleteEmployee"/>
    </ToolBar>

    <!-- Основное содержимое -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
        </padding>

        <!-- Поиск -->
        <HBox spacing="10">
            <Label text="Поиск:" style="-fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
            <TextField fx:id="searchField" promptText="Введите текст для поиска по всем полям..." HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Таблица сотрудников -->
        <TableView fx:id="employeeTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" text="ФИО сотрудника" prefWidth="220"/>
                <TableColumn fx:id="deptColumn" text="Отдел" prefWidth="130"/>
                <TableColumn fx:id="posColumn" text="Должность" prefWidth="150"/>
                <TableColumn fx:id="expColumn" text="Стаж (лет)" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Строка состояния -->
        <HBox>
            <Label fx:id="statusLabel" text="Статус: Готово. Всего записей: 10"/>
        </HBox>
    </VBox>
</VBox>