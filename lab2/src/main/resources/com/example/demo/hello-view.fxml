<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" fx:controller="com.example.demo.HelloController" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- Заголовок -->
    <Label text="КАРТОЧКА СТУДЕНТА">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
    </Label>

    <!-- Сетка с полями ввода -->
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="140.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="250.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES"/>
        </rowConstraints>
        <children>
            <!-- Имя -->
            <Label GridPane.columnIndex="0" GridPane.rowIndex="0" text="Имя:"/>
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="0" fx:id="txtName" promptText="Введите имя"/>

            <!-- Фамилия -->
            <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Фамилия:"/>
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" fx:id="txtSurname" promptText="Введите фамилию"/>

            <!-- Возраст -->
            <Label GridPane.columnIndex="0" GridPane.rowIndex="2" text="Возраст:"/>
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="2" fx:id="txtAge" promptText="Введите возраст"/>

            <!-- Специальность -->
            <Label GridPane.columnIndex="0" GridPane.rowIndex="3" text="Специальность:"/>
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="3" fx:id="txtSpeciality" promptText="Например: ИС"/>

            <!-- Курс -->
            <Label GridPane.columnIndex="0" GridPane.rowIndex="4" text="Курс:"/>
            <ComboBox GridPane.columnIndex="1" GridPane.rowIndex="4" fx:id="cmbCourse" prefWidth="250.0"/>

            <!-- Город (Самостоятельная часть) -->
            <Label GridPane.columnIndex="0" GridPane.rowIndex="5" text="Город:"/>
            <ComboBox GridPane.columnIndex="1" GridPane.rowIndex="5" fx:id="cmbCity" prefWidth="250.0"/>

            <!-- Форма обучения (Самостоятельная часть) -->
            <Label GridPane.columnIndex="0" GridPane.rowIndex="6" text="Форма обучения:"/>
            <HBox GridPane.columnIndex="1" GridPane.rowIndex="6" alignment="CENTER_LEFT" spacing="15.0">
                <children>
                    <RadioButton fx:id="rbOchnaya" mnemonicParsing="false" selected="true" text="Очная">
                        <toggleGroup>
                            <ToggleGroup fx:id="studyGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="rbZaochnaya" mnemonicParsing="false" text="Дистанционная" toggleGroup="$studyGroup"/>
                </children>
            </HBox>

            <!-- Общежитие (Самостоятельная часть) -->
            <CheckBox GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="7" fx:id="chkHostel" mnemonicParsing="false" text="Проживает в общежитии"/>
        </children>
    </GridPane>

    <!-- Панель с кнопками -->
    <HBox alignment="CENTER" spacing="10.0">
        <children>
            <Button fx:id="btnCreate" mnemonicParsing="false" onAction="#onCreateClick" text="Сформировать"/>
            <Button fx:id="btnClear" mnemonicParsing="false" onAction="#onClearClick" text="Очистить"/>
            <Button fx:id="btnExit" mnemonicParsing="false" onAction="#onExitClick" text="Выход"/>
        </children>
    </HBox>

    <!-- Метка для вывода результата -->
    <Label fx:id="lblResult" text="Результат:" wrapText="true"/>
</VBox>